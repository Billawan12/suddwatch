# ============================================================
# SuddWatch - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to GitHub
# ============================================================

# --- Copernicus Data Space (https://dataspace.copernicus.eu) ---
# Used by: src/data_acquisition.py to download Sentinel-1 SAR scenes
COPERNICUS_USER=your_copernicus_email_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# --- Twilio SMS Alerts (https://console.twilio.com) ---
# Used by: src/alerts.py to send SMS flood alerts to recipients
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12345678901

# --- Gmail SMTP Email Alerts ---
# Used by: src/alerts.py to send detailed email alerts with attachments
# SMTP_PASSWORD must be a Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- GitHub (https://github.com/settings/tokens) ---
# Used by: src/pipeline.py to commit flood outputs (GeoJSON, CSV) to repo
# Required scope: repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Alert Recipients ---
# SMS_RECIPIENTS: comma-separated phone numbers in international format
# EMAIL_RECIPIENTS: comma-separated email addresses
SMS_RECIPIENTS=+254700000000,+256700000001
EMAIL_RECIPIENTS=coordinator@unocha.org,admin@redcross.org

# --- Target Area Bounding Box ---
# Covers Jonglei, Unity, and Upper Nile states in South Sudan
BOUNDING_BOX_MIN_LAT=5.0
BOUNDING_BOX_MIN_LON=29.0
BOUNDING_BOX_MAX_LAT=12.0
BOUNDING_BOX_MAX_LON=35.0
