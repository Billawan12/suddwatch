# ============================================================
# SuddWatch - Environment Variables Template
# Copy this file to .env and fill in your values:   cp .env.example .env
# NEVER commit the .env file to GitHub (it is in .gitignore)
# ============================================================

# --- Copernicus Data Space (https://dataspace.copernicus.eu) ---
# Used by: src/data_acquisition.py to search for and download Sentinel-1 scenes
COPERNICUS_USER=your_copernicus_email_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# --- Twilio SMS Alerts (https://console.twilio.com) ---
# Used by: src/alerts.py
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12345678901

# --- Gmail SMTP Email Alerts ---
# SMTP_PASSWORD must be a Gmail App Password (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Alert recipients (comma-separated) ---
# Can also be edited from the dashboard: Admin → Alert Config
SMS_RECIPIENTS=+211921000001,+211921000002
EMAIL_RECIPIENTS=coordinator@unocha.org,analyst@reach-initiative.org

# --- Optional settings (defaults shown) ---------------------------------

# Alert is sent if flood extent >= this many hectares OR affected
# population >= this many people. (Admin → Alert Config overrides these.)
# ALERT_FLOOD_THRESHOLD_HA=500
# ALERT_POPULATION_THRESHOLD=1000

# Public URL of the dashboard, included in SMS/email. Leave unset if the
# dashboard only runs on your laptop (a localhost link is useless on a phone).
# DASHBOARD_URL=https://suddwatch.example.org

# Where ESA SNAP's command-line tool is installed
# SNAP_GPT_PATH=/Applications/esa-snap/bin/gpt

# Dry-season baseline scene (preprocessed dB GeoTIFF) for change detection.
# If the file does not exist, change detection is skipped.
# DRY_SEASON_BASELINE_PATH=data/processed/baseline_dry_season_db.tif

# Villages / clinics within this distance of flood water count as "near flood"
# NEAR_FLOOD_BUFFER_M=1000

# How many days back each run searches Copernicus for new scenes
# SCENE_SEARCH_DAYS=7

# Detector: "threshold" (default) or "random_forest" (experimental)
# DETECTION_METHOD=threshold

# --- Target area (Jonglei, Unity, Upper Nile) ---
BOUNDING_BOX_MIN_LAT=5.0
BOUNDING_BOX_MIN_LON=29.0
BOUNDING_BOX_MAX_LAT=12.0
BOUNDING_BOX_MAX_LON=35.0

# --- GitHub (optional, currently unused) ---
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
